# Storage & Cache (SQLite + in-memory rate limiter work locally; switch to Postgres + Redis in Docker)
DATABASE_URL=sqlite:///data/sovereign.db
REDIS_URL=

# Service Auth Keys
MCP_API_KEY=dev-mcp-internal-key
ADMIN_API_KEY=dev-admin-secret-key

# Service Ports & Endpoints
ERP_MCP_URL=http://127.0.0.1:8101/mcp
ERP_ADMIN_URL=http://127.0.0.1:8101
KNOWLEDGE_MCP_URL=http://127.0.0.1:8102/mcp
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Model Routing — supports Google Cloud Vertex AI via ADC (`vertex_adc`) or `$0` offline planners (`offline`)
LLM_MODE=vertex_adc
PRIMARY_MODEL=gemini-3.8-flash
FALLBACK_MODEL=gemini-3.5-flash-lite
VERTEX_PROJECT_ID=gen-lang-client-0430700811
VERTEX_LOCATION=global
# Optional explicit ADC credentials file path (defaults to ~/.config/gcloud/application_default_credentials.json)
GOOGLE_APPLICATION_CREDENTIALS=

# Langfuse Observability (optional; traces always persist locally in structured JSON + DB)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
